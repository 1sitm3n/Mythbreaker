{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Desktop editor and player (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/desktop",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "MYTHBREAKER_BUILD_DESKTOP": "ON", "MYTHBREAKER_BUILD_TESTS": "ON" }
    },
    {
      "name": "headless",
      "displayName": "Core, CLI and tests without graphics dependencies",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/headless",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MYTHBREAKER_BUILD_DESKTOP": "OFF", "MYTHBREAKER_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "desktop", "configurePreset": "desktop" },
    { "name": "headless", "configurePreset": "headless" }
  ],
  "testPresets": [
    { "name": "desktop", "configurePreset": "desktop", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } }
  ]
}
